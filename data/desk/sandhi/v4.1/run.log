text(await tools.exec_command({cmd:"cat > model-01-v4.1/scripts/write_handback.py <<'PY'\nfrom pathlib import Path\nimport sys,json,hashlib,datetime\nP=Path(__file__).resolve().parents[1]\nB=P/'input/model-01-bundle-v4.1-2026-10-19';V=B/'v4-output/extracted/model-01-v4'\nLABEL=\"Internal review: the setup was corrected after day 3's arrays were opened. These comparisons are not scores and do not count for or against version 4.\"\nSENTENCES=['The model is a kinetic description; it names no cause.','The sweep clock is the returned order; seconds are conditional on that order being chronological.',\"The predictions are the model's, written before the run they predict, and they are what can count against it.\"]\ndef load(n):return json.loads((P/n).read_text())\ndef fmt(v):\n if v is None:return 'unavailable'\n if isinstance(v,bool):return str(v)\n if isinstance(v,(float,int)):return f'{v:.6g}'.replace('-','−')\n return str(v)\ndef ci(v):return 'unavailable' if v is None else fmt(v[0])+' to '+fmt(v[1])\ndef write(n,lines): (P/n).write_text('\\n'.join(lines)+'\\n')\ndef table(head,rows):return ['| '+' | '.join(head)+' |','|'+'|'.join(['---']*len(head))+'|']+['| '+' | '.join(map(str,row))+' |' for row in rows]\ndef main():\n a=load('internal-review-day3.json')['result'];h=load('hierarchy-model-01-v4.1.json');f=load('fits-model-01-v4.1.json');state=load('calibration-state.json');audit=load('audit-part-a.json');ab=load('audit-part-b.json');v4=json.loads((V/'predictions-model-01-v4.json').read_text());nom={d:load('nominal-'+d+'.json') for d in ('D1','D2')}\n for n in ('rehearsal-day2.json','rehearsal-day3.json','calibration-audit.json'):assert (P/n).exists()\n # Part A results always carry the required label; tables are under that label too.\n lines=[LABEL,'','# Day 3 internal review','',*SENTENCES,'',LABEL+' The files below use the frozen v4 prediction digest and a calibration state derived only from its frozen hierarchy and bootstrap samples.','',f\"Frozen prediction JSON SHA256: `{a['prediction_sha256']}`.\",'',f\"Frozen calibration state SHA256: `{a['calibration']['state_sha256']}`.\",'','## All interval comparisons','',LABEL,'']\n rows=[]\n for e in a['prediction_comparisons']:\n  for o in e.get('observations',[]):rows.append([f\"`{e['quantity']}`\",o['unit'],fmt(o['value']),ci(e['interval_90']),fmt(o['inside_90']),o['status']])\n lines+=table(['Quantity','Unit','Observed','Conditional 90 percent interval','Inside','Status'],rows)\n lines+=['','## Families','',LABEL,'']+table(['Family','Compared','Expected','Misses','Cutoff','Formal criterion met','Status'],[[x['family'],x['bets_compared'],x['expected_bets'],x['misses'],fmt(x['smallest_miss_count_under_0p05']),fmt(x['counts_against']),x['status']] for x in a['families']])\n lines+=['',LABEL+' The formal criterion column records the result of the comparison rule only; it has no prospective standing.','', '## Structural criteria','',LABEL,'']+table(['Criterion','Observed','Formal criterion met'],[\n ['Any monitor span INDEPENDENT or UNDECIDED',str(a['sharing_spans_counting_against']),str(bool(a['sharing_spans_counting_against']))],\n ['More than one dwell probability below 0.01',str(a['monitor_dwell_failures_under_0p01']),str(a['more_than_one_monitor_dwell_failure'])],\n ['CHANGE at a boundary assigned probability below 0.05',str([x['word'] for x in a['scenario_comparisons'][0]['boundary_CHANGE_against_low_probability']]),str(a['scenario_comparisons'][0]['any_boundary_CHANGE_against_low_probability'])]])\n lines+=['','## Count intervals and probabilities','',LABEL,'']+table(['Word','Count','90 percent interval','Inside'],[[x['word'],x['observed'],ci(x['interval_90']),x['inside_90']] for x in a['scenario_comparisons'][0]['count_intervals']])\n lines+=['',LABEL,'']+table(['Event','Conditional probability','Observed','Monte Carlo 90 percent interval'],[[x['prediction'],fmt(x['probability']),fmt(x.get('observed',x.get('observed_all_preference'))),ci((x.get('calibration') or {}).get('mc_interval_90'))] for x in a['scenario_comparisons'][0]['probability_events']])\n lines+=['',LABEL,'']+table(['Boundary','CHANGE probability','Observed word','Formal criterion met'],[[x['boundary_key'],fmt(x['predicted_CHANGE_probability']),x['word'],x['counts_against']] for x in a['scenario_comparisons'][0]['boundary_CHANGE_against_low_probability']])\n lines+=['',LABEL+' The observed A26 weights come from the run fits file, with their field paths and digests retained in the JSON.','',LABEL+' The shuffled sd remains unavailable because v4 supplies a distribution of population correlation lengths and no unique observed scalar for that quantity.','', 'Alternatives recorded without selection: a plug in length at a fitted date mean; a median or mean across the frozen population distribution; or the median observed monitor correlation time borrowed by test 16. Each changes or completes the observation definition and none is substituted for it.','', 'The original v4 list specifies joint miss criteria for duty, correlation and emissions only. The job mean difference and shuffled weight have interval comparisons but no supplied joint family cutoff. Their family decisions remain unavailable.','', 'Source fields: `internal-review-day3.json/result`, `part-a-calibration.json/scenario`, `audit-part-a.json` and the frozen `v4-output` files.']\n write('internal-review-day3.md',lines)\n rows=[]\n for setname in ('primary','with_test14'):\n  for param in ('logit_b','log_ell'):\n   old=h['v4_beside'][setname]['parameters'][param];new=h[setname]['parameters'][param];rows.append([setname,param,fmt(old['sigma']),ci(old['sigma_profile_ci90']),fmt(new['sigma']),ci(new['sigma_profile_ci90'])])\n lines=['# Model 01 version 4.1','','## Three required checks','',\n '1. All 125 test 15 comparisons agree at test 16’s stated absolute tolerance of 10⁻¹²; 120 are exactly equal and five differ by at most 2.7755575615628914 × 10⁻¹⁷. Literal bitwise equality for all 125 is not met. The unchanged v4 estimator already has these differences from the independent test 16 reading, so changing it would exceed C1 to C3. Source: `audit-part-a.json/comparison_125`.',\n '2. All 107393 compared leaves outside C1 to C3 reproduce the original v4 handback exactly after required presentation label normalization. Numerical differences are zero. Execution time, file locations and corrected calibration products are excluded explicitly. Source: `audit-part-a.json/unaffected_v4_scorecard`.',\n '3. `scorer-diff-v4.1.md` lists every scorer replacement line and every line of the added calibration dependency, with C1, C2 or C3 attribution. All six inherited scorer dependencies are byte equal to v4. Reapplying the listed replacements reconstructs the entire scorer. Source: `scorer-diff-audit.json`.','',*sum(([s,''] for s in SENTENCES),[]),\n '## Scope, integrity and sequence','',\n 'This is a local desk run dated 19 October 2026. Scientific inputs come only from the supplied v4.1 bundle. A memory registry was consulted for workflow orientation before the bundle was read; no earlier result was imported from that registry. The required prompt, kickoffs, reports and predictions were read before analysis code was written. No external scientific source was fetched.',\n '', 'The outer archive digest matches. All 23 manifest entries, both inner archive digests, and all six day 3 array and metadata entries match. All 78 entries of the returned v4 manifest and all nine forecast entries match. The forecast manifest digest is `1115b9bdddb43c0e81a68905709a8025d58106799e69da40f89614e76bddfcc2`, matching the value carried by test 16. The inner input checks comprise 60 manifest entries and 24 present array record entries. The two absent test 9 files are explicitly omitted by that bundle. Sources: `integrity.json`, `frozen-integrity.json`, `v4-input-integrity.json`.',\n '', 'Corrections C1 to C3 were implemented first. Part A used the frozen v4 files. The Part A numerical audit completed before Part B began. The new fits then supplied the three date hierarchy. Rehearsals and nominal simulations completed before the prediction files were written. All simulation counts were retained without a compute reduction.',\n '', 'The hash parser initially encountered prose in a hash record and later trailing annotations in six filenames. Both parser issues were corrected before those files were analyzed. The first Part A audit also compared six required presentation labels literally; the correction normalizes labels only. An unused original applicability function was removed under C1 and C2 while the first Part A computation was running; it had no call site in that computation. No numerical method changed. These events remain in `run.log`.',\n '', '## Kinds and definitions','',\n 'Counts, sweep series, threshold duties and supplied A26 weights are computed facts of the supplied record. HMM rates, stationary duties, hierarchy spreads, simulated intervals and probabilities are model outputs. The final three paragraphs are readings. No result is adopted by this report.',\n '', 'The C1 calibration receives only row counts after straddling repeats are removed, circuit schema, shots, sweep counts, durations and span counts. The design extraction is unchanged when counts, fits and observed A26 weights are replaced. The calibration handles unequal span counts and one monitor job. Nominal templates are display examples, not admission gates.',\n '', 'C2 uses every actual sweep time. Its primary range is 0.9 times the smallest donor time through 1.1 times the largest. Padding each endpoint by ten percent of the range width is retained as an alternative; both include every day 3 span. Outside the primary range, seconds comparisons remain uncalibrated and the correlation criterion uses a separately calibrated dimensionless subfamily. The full set of observed quantities remains displayed.',\n '', 'C3 reads `span_readings_A26/weight_per_span/weighted_mean` from the supplied run fits and records its source digest and span. It does not reconstruct A26. The borrowed shuffled sd has no unique observed population length scalar in the frozen definition, so it remains unavailable; the alternatives are listed in the internal review. The weight interval definition retains the absolute 0.011 allowance.',\n '', '## Part A','',LABEL+' Duty has 0 misses in 12 comparisons, correlation has 0 in 24, and emissions has 0 in 8; the calibrated cutoffs are 7, 9 and 4 respectively.','',LABEL+' One of the three A26 weights is outside its interval, while all four within job boundary words are NO CHANGE and no structural criterion is met.','',LABEL+' The complete per unit comparisons, probabilities, boundary criteria and unavailable definitions are in `internal-review-day3.md` and `.json`; the official day 3 handback remains test 16’s.','',\n '## Part B fits and hierarchy','',\n 'The primary hierarchy has 15 spans from five monitor jobs on three UTC dates. Including test 14 gives 18 spans from six jobs. Test 14 remains NOT USABLE under its own rule and is beside the primary set. The 15 eligible kingston spans and all original job fits and bootstrap files are carried exactly. Existing job parameters do not share a likelihood with the new jobs, so adding the new records does not require changing those job fits. Sources: `fits-model-01-v4.1.json`, `data-model-01-v4.1.json`, `hierarchy-model-01-v4.1.json` and `audit-part-b.json`.',\n '', 'Each new monitor job uses 400 parametric bootstrap draws with the unchanged float64 forward likelihood. Both fits and all 800 bootstrap refits converged. The hierarchy uses the unchanged normal normal maximum marginal likelihood method and 400 draws per transformed parameter and set. New within job and adjacent job boundary comparisons use 400 null and 400 alternative draws. Original alternatives, control fits and boundaries remain in the fits file.',\n '']+table(['Set','Parameter','v4 spread','v4 90 percent profile interval','v4.1 spread','v4.1 90 percent profile interval'],rows)\n lines+=['','The spreads above are on the logit duty and natural log length scales. The duty profile includes zero, and the length profile remains above zero. The hierarchy bootstrap samples and profile intervals are retained, along with the earlier leave one job out record labelled as carried.','', '## Rehearsal and numerical checks','',\n 'The corrected scorer was rehearsed on both day 2 and day 3 arrays using the v4.1 state. These are computation checks on opened records, not prospective validation. A separate Python log domain forward calculation agrees with all six new span likelihoods within 6.04 × 10⁻¹⁰. Every old job fit and bootstrap file remains equal to its frozen counterpart. Sources: `rehearsal-day2.json`, `rehearsal-day3.json` and `audit-part-b.json`.',\n '', 'Every actual design or nominal calibration uses 2000 complete simulated days, with 1000 for interval construction and 1000 for joint family miss calibration. Its first 100 days receive likelihood comparisons with 400 null draws at every relevant boundary. Draw counts, seeds, every trial, convergence flags and Monte Carlo intervals are retained. The independent calibration audit recounts intervals, boundary probabilities and family cutoffs from the saved trials. Source: `calibration-audit.json`.',\n '', '## Prediction scope','',\n 'D1 is the next two job monitor run with 300 positions per job, 1000 shots and X then Y at 5.6 µs on 143, with any number of spans. Its nominal example uses day 3 design metadata. D2 is one job of the same circuits with 600 positions, nominally six spans. Its nominal example has six contiguous blocks of 100 positions and a donor mean sweep time. Actual intervals and criteria for both are recomputed from the future design at scoring time.',\n '', 'The empirical day extension now chooses one of three observed UTC dates uniformly once per simulated day and draws emission vectors from a job on that date. This preserves the v4 extension and its limits; it does not establish a population of future dates or emissions. There is no additional middle span parameter, channel or bet. No prediction beyond stationarity within a job is issued for that pattern.',\n '', '## Readings, labelled','',\n 'Reading of the third date: adding six spans narrows the duty spread profile and moves its fitted value to zero. The fitted log length spread decreases from about 0.377 to 0.297 but remains above zero in its profile interval. Within this model, the new date does not require larger between span spreads.',\n '', 'Reading of slower switching: the six day 3 fitted lengths and test 15 correlation times lie inside the original v4 nominal three span intervals, and also inside the corrected conditional intervals. The new date mean is higher than the earlier date means, while its spans do not enlarge the fitted common length spread. This is a statement about the fitted description and its intervals.',\n '', LABEL+' Reading of the internal review: correcting the design opens comparisons that the original support gates withheld, and exposes the one shuffled weight outside its interval; it does not create a prospective test because the arrays were already opened when the setup was corrected.',\n '', 'The author and Mantri may read these records and recount what they can. Nothing here is adopted.']\n write('report-model-01-v4.1.md',lines)\n # Final scientific outputs: predictions are written after report, audit and rehearsals.\n entries=[];scenarios={}\n for design,n in nom.items():\n  s={k:v for k,v in n['scenario'].items() if k!='failures'};s['nominal']=True;s['design_name']=design;s['description']=n['nominal'];s['source_basis']=state['basis'];scenarios[design]=s\n  for q,inter in s['intervals'].items():\n   if inter is not None:entries.append({'id':design+'_'+q,'design':design,'quantity':q,'nominal':True,'status':'issued','interval_90':inter,'definition':'Same v4 quantity; nominal display interval. C1 recalculates from actual design at scoring time.','source_basis':state['basis']})\n output={'schema':'model01_v4_1_predictions_1','created_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'scorer':'score_model_01_v4_1.py','calibration_state':'calibration-state.json','calibration_state_sha256':hashlib.sha256((P/'calibration-state.json').read_bytes()).hexdigest(),\n 'record_basis':state['basis'],'scope':'Conditional empirical day extension over three observed UTC dates; no unrestricted fourth date forecast.',\n 'designs':{'D1':'Next 143 monitor run, two jobs, 300 positions each, 1000 shots, 5.6 microseconds X then Y, any span counts.','D2':'One longer job of the same circuits, 600 positions, 1000 shots, about six spans.'},\n 'calibration':'C1 at scoring time through actual design. Nominal intervals never gate eligibility. C2 actual sweep time with donor endpoint range widened ten percent on each side. C3 supplied per span A26 weights.',\n 'entries':entries,'scenarios':scenarios,'counts_against':v4['counts_against'],\n 'middle_span_pattern':'No channel, parameter or bet added. No prediction beyond stationarity within a job. Span position has no effect in the model.',\n 'limits':{'fixed_date_means':'The hierarchy contains three fixed observed date means, not an identified future date population.','emissions':'Empirical donors on three dates only.','shuffled_sd':'No unique observed population length scalar is specified; observed sd remains unavailable with alternatives recorded.','shuffled_weight':'Assumed relation to time averaged duty with absolute 0.011 allowance.','prior_record_limits':v4['record_limits'],'chronology':'Seconds conditional on chronological returned order and even sweep spacing.'},\n 'rehearsals':['rehearsal-day2.json','rehearsal-day3.json'],'audit':['audit-part-a.json','audit-part-b.json','calibration-audit.json','scorer-diff-audit.json'],'adoption':'Nothing adopted; ready for the author to hash before the future run.'}\n lines=['# Model 01 version 4.1 predictions','',*sum(([s,''] for s in SENTENCES),[]),'These are model outputs from the conditional empirical day extension over 15 spans, five monitor jobs and three UTC dates. The third date is included in the fit. The predictions address a future run; they are not predictions of day 3.','', '## Designs and calibration','', output['designs']['D1'],'',output['designs']['D2'],'',output['calibration'],'','The actual span counts may differ between jobs. The full eligible design is primary. The JSON retains each nominal design and every indexed boundary probability.','', '## Nominal intervals','']\n qs=list(dict.fromkeys(e['quantity'] for e in entries));lines+=table(['Quantity','D1 nominal 90 percent interval','D2 nominal 90 percent interval'],[[f'`{q}`',ci(scenarios['D1']['intervals'].get(q)),ci(scenarios['D2']['intervals'].get(q))] for q in qs])\n lines+=['','D1 uses day 3 design metadata as a nominal example. D2 uses six equal position blocks with first and last readout pairs excluded and the mean donor sweep time. These examples do not predict the future execution metadata.','', '## Nominal counts and probabilities','']\n lines+=table(['Design','Every span SHARED','Any likelihood rejection at one percent','Every returned order fit preferred'],[[d,fmt(s['sharing_all_probability']['probability']),fmt(s['any_LR_reject_probability']['probability']),fmt(s['returned_order_all_preference_probability']['probability'])] for d,s in scenarios.items()])\n lines+=['','A probability estimate of one is a finite simulation estimate. Monte Carlo intervals and counts are in the JSON. The order preference probability is conditional on simulating in returned order; it is not a probability that the returned order is chronological.','']\n lines+=table(['Design','Boundary word','Expected count','Nominal 90 percent count interval'],[[d,w,fmt(x['expected_count']),ci(x['interval_90'])] for d,s in scenarios.items() for w,x in s['boundary_counts'].items()])\n lines+=['','## What would count against the model','']+table(['Design','Family','Nominal cutoff','Bets'],[[d,fam,x['cutoff'],x['k']] for d,s in scenarios.items() for fam,x in s['family_miss_thresholds'].items()])\n lines+=['','Family cutoffs are the smallest miss counts whose one sided 95 percent Monte Carlo upper probability is below five percent. The actual design is calibrated again at scoring time. Any 143 monitor span reading INDEPENDENT or UNDECIDED counts against sharing. More than one monitor span with a dwell probability below 0.01 counts against the dwell description. A CHANGE boundary counts against its prediction where that indexed boundary had CHANGE probability below five percent. The list is unchanged from v4.','', 'No channel is added for the middle span pattern, and no prediction beyond stationarity within a job is issued for it. The shuffled weight remains the v4 assumption about a second estimator, now read from its supplied fits. The observed borrowed sd remains unavailable without a unique specified population length.','', 'Both archive rehearsals are computation checks, not prospective validation. The author and Mantri may recount what they can. Nothing here is adopted.']\n write('predictions-model-01-v4.1.md',lines);(P/'predictions-model-01-v4.1.json').write_text(json.dumps(output,indent=2,allow_nan=False))\n print('Reports written; predictions written last at',output['created_utc'])\nif __name__=='__main__':main()\nPY\nbash model-01-v4.1/scripts/run-command.sh python3 -m py_compile model-01-v4.1/scripts/write_handback.py","max_output_tokens":1000}));


