text(await tools.exec_command({cmd:"cat > model-01-v4.1/scripts/audit_part_b.py <<'PY'\nfrom pathlib import Path\nimport sys,json,hashlib,copy\nP=Path(__file__).resolve().parents[1];sys.path.insert(0,str(P))\nimport numpy as np\nfrom scipy.special import logsumexp,gammaln\nfrom scipy.stats import beta\nfrom record_io import jload,save\nfrom calibration_v4_1 import support,design_only\nfrom score_model_01_v4_1 import score_entries\nV=P/'input/model-01-bundle-v4.1-2026-10-19/v4-output/extracted/model-01-v4'\nd=jload(P/'data-model-01-v4.1.json');f=jload(P/'fits-model-01-v4.1.json');old=jload(V/'fits-model-01-v4.json');h=jload(P/'hierarchy-model-01-v4.1.json');state=jload(P/'calibration-state.json')\nrows=[]\nfor s in d['spans']:\n if s['test']!='t11-day3':continue\n n=np.asarray(s['n'],dtype=np.float64);R=np.asarray(s['R'],dtype=np.float64);q=np.asarray([s['q_L'],s['q_H']]);u=s['fit']['u'];down=s['fit']['d'];b=u/(u+down);A=np.array([[1-u,u],[down,1-down]])\n le=n.T@np.log(q).T+(R[:,None]-n).T@np.log1p(-q).T\n alpha=np.log([1-b,b])+le[0]\n for j in range(1,n.shape[1]):alpha=le[j]+logsumexp(alpha[:,None]+np.log(A),axis=0)\n ll=float(logsumexp(alpha)+np.sum(gammaln(R[:,None]+1)-gammaln(n+1)-gammaln(R[:,None]-n+1)))\n rows.append({'id':s['id'],'independent_loglik':ll,'fit_loglik':s['fit']['loglik'],'absolute_difference':abs(ll-s['fit']['loglik']),'within_1e8':abs(ll-s['fit']['loglik'])<=1e-8})\nold_equal={k:f['jobs'][k]==v for k,v in old['jobs'].items()}\nboot_equal={k:hashlib.sha256((P/('bootstrap-'+k+'.json')).read_bytes()).hexdigest()==hashlib.sha256((V/('bootstrap-'+k+'.json')).read_bytes()).hexdigest() for k in old['jobs']}\nassert all(old_equal.values()) and all(boot_equal.values()) and all(x['within_1e8'] for x in rows)\n# Exercise the C2 fallback without new numerical fits: a doubled sweep clock must leave dimensionless outcomes available.\na=jload(P/'internal-review-day3.json')['result'];design=design_only(a['jobs'],a['shuffled']);out=copy.deepcopy(design)\nfor g in out['jobs']:\n for s in g:s['sweep_s']=10.;s['duration_s']=s['N']*10.\nsup=support(out,state);assert sup['dimensionless_applicable'] and not sup['seconds_applicable']\nentries=[{'id':q,'quantity':q,'interval_90':[0,2],'family':'correlation','status':'issued'} for q in ('t15_tau_sweeps','t15_tau_seconds','model_ell_sweeps','model_ell_seconds')]\nobs={q:[{'unit':'example','value':1}] for q in ('t15_tau_sweeps','t15_tau_seconds','model_ell_sweeps','model_ell_seconds')}\nrr,fam=score_entries({'entries':entries},obs,{'_applicability':sup,'family_miss_thresholds':{'correlation':{'cutoff':2,'k':2}}});assert fam[0]['bets_scored']==2 and fam[0]['status']=='scored'\nassert all(r['observations'][0]['inside_90'] is None for r in rr if 'seconds' in r['quantity'])\n# Arbitrary unequal job span counts survive design extraction; the scorer no longer selects a nominal span count template.\nunequal=copy.deepcopy(design);unequal['jobs'][1]=unequal['jobs'][1][:-1];assert support(unequal,state)['dimensionless_applicable']\nresult={'independent_forward_algorithm':rows,'old_job_fits_exactly_carried':old_equal,'old_bootstrap_files_byte_equal':boot_equal,\n 'primary_basis':state['basis'],'C2_outside_range_dimensionless_still_calibrated':True,'C2_seconds_remain_uncalibrated':True,'C1_unequal_span_counts_supported':True,\n 'new_fit_success':{k:v['shared_emissions_fit']['success'] for k,v in f['jobs'].items() if k.startswith('day3')},'new_bootstrap_failures':{k:len(v['bootstrap']['failures']) for k,v in f['jobs'].items() if k.startswith('day3')},\n 'new_boundary_failures':[{'ids':x.get('ids',x.get('jobs')),'failures':x['failures']} for a in f['new_day3_boundaries'].values() for x in a if x['failures']]}\nsave(P/'audit-part-b.json',result);print(json.dumps(result,indent=2))\nPY\nbash model-01-v4.1/scripts/run-command.sh env OPENBLAS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 [local path] -I -B model-01-v4.1/scripts/audit_part_b.py","yield_time_ms":1000,"max_output_tokens":4000}));


