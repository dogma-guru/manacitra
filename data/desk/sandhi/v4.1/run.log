text(await tools.exec_command({cmd:"cat > model-01-v4.1/scripts/run_part_b.py <<'PY'\nfrom pathlib import Path\nimport sys,json,copy,datetime,shutil\nP=Path(__file__).resolve().parents[1];sys.path.insert(0,str(P));sys.path.insert(0,str(P/'scripts'))\nimport numpy as np\nfrom record_io import monitor_series,read_arrays,jload,counts_check,save,sha\nfrom hmm_model import fit_job,fit_bootstrap\nfrom run_hierarchy import build\nfrom run_boundaries import boundary_test_spans,boundary_test_job_pair\nfrom make_state import make\nB=P/'input/model-01-bundle-v4.1-2026-10-19';V=B/'v4-output/extracted/model-01-v4';D=B/'t11-day3'\ndef main():\n assert (P/'audit-part-a.json').exists()\n audit=jload(P/'audit-part-a.json');assert audit['comparison_125']['within_1e12_count']==125 and not audit['unaffected_v4_scorecard']['differences']\n data=jload(V/'data-model-01-v4.json');fits=jload(V/'fits-model-01-v4.json');oldh=jload(V/'hierarchy-model-01-v4.json');boots={}\n for key in fits['jobs']:\n  shutil.copy2(V/('bootstrap-'+key+'.json'),P/('bootstrap-'+key+'.json'));boots[key]=jload(P/('bootstrap-'+key+'.json'))\n fits['v4_1_provenance']={'method':'V4 method unchanged. Existing job fits and bootstrap samples carried exactly; the likelihood has no parameters shared between jobs. Two new monitor jobs fitted with the same implementation. Hierarchy refitted after adding their six spans.','v4_fits_sha256':sha(V/'fits-model-01-v4.json'),'started_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'new_job_seeds':[41119100,41119101]}\n newgroups=[]\n for i,job in enumerate((2,3)):\n  key=f'day3-job{job}';ap=D/f'shots-t11-day3-job{job}.npz';mp=D/f'shots-t11-day3-job{job}-meta.json';cp=D/f'counts-t11-day3-job{job}.json';arr=read_arrays(ap);rec=jload(cp);meta=jload(mp);assert counts_check(arr,rec)['pass_check']\n  ss,membership=monitor_series(arr,rec,meta,key,qubits=[143]);group=key+'-q143';f=fit_job(ss);free=[fit_job([s]) for s in ss];idx=np.column_stack([np.arange(500),np.arange(500,1000)]).ravel();inter=fit_job([{**s,'n':np.asarray(s['n'])[:,idx]} for s in ss]);boot=fit_bootstrap(ss,f,400,41119100+i);boots[group]=boot;save(P/('bootstrap-'+group+'.json'),boot);small={k:v for k,v in boot.items() if k!='samples'}\n  fits['jobs'][group]={'shared_emissions_fit':f,'free_emissions_fits':free,'free_minus_shared_loglik':sum(a['loglik'] for a in free)-f['loglik'],'interleaved_halves_fit':inter,'bootstrap_file':'bootstrap-'+group+'.json','bootstrap':small,'membership':membership}\n  for si,(s,v) in enumerate(zip(ss,f['spans'])):\n   s.update({'test':'t11-day3','source':{'array':str(ap.relative_to(P)),'array_sha256':sha(ap),'meta':str(mp.relative_to(P)),'counts':str(cp.relative_to(P))},'fit':v,'q_H':f['q_H'],'q_L':f['q_L'],'fit_group':group,'fit_ci90':small['spans'][si],'emission_ci90':small['emissions']})\n   data['spans'].append(s);fits['spans'].append({'id':s['id'],'group':group,**v,'q_H':f['q_H'],'q_L':f['q_L'],'bootstrap':small['spans'][si],'ell_seconds':v['ell']*s['sweep_s'] if v['ell'] else None,'free_emissions_fit':free[si]['spans'][0],'returned_loglik':v['loglik'],'interleaved_loglik':inter['spans'][si]['loglik']})\n  newgroups.append(ss);print(group,'fit complete','bootstrap',400,'failures',len(boot['failures']),flush=True)\n fits['hierarchy']={'primary':build(data['spans'],boots,False,seed=41119200),'with_test14':build(data['spans'],boots,True,seed=41119210)}\n hierarchy={**fits['hierarchy'],'method':oldh['choices']['hierarchy'],'intervals':oldh['choices']['intervals'],'v4_beside':{k:oldh[k] for k in ('primary','with_test14')},'source':'data-model-01-v4.1.json and per job bootstrap files','future_date_limit':'Fixed means for three UTC dates do not identify an unrestricted fourth date mean. The empirical day extension chooses among the three observed dates uniformly.','leave_one_job_out_v4_carried':oldh['leave_one_job_out']}\n # All old boundaries retained; new adjacent spans and chronological job pairs use the same full bootstrap method.\n fits['new_day3_boundaries']={'within_jobs':[],'between_jobs':[]}\n for ji,g in enumerate(newgroups):\n  for si,(a,b) in enumerate(zip(g[:-1],g[1:])):\n   r=boundary_test_spans([a,b],draws=400,seed=41119400+ji*10+si,interval_draws=400);fits['new_day3_boundaries']['within_jobs'].append(r)\n previous=[s for s in data['spans'] if s['job']=='t14-job1']\n for ji,(a,b) in enumerate(zip([previous]+newgroups[:-1],newgroups)):\n  r=boundary_test_job_pair([a,b],draws=400,seed=41119500+ji,interval_draws=400);fits['new_day3_boundaries']['between_jobs'].append(r)\n fits['v4_1_provenance']['completed_utc']=datetime.datetime.now(datetime.timezone.utc).isoformat();save(P/'fits-model-01-v4.1.json',fits);save(P/'data-model-01-v4.1.json',data);save(P/'hierarchy-model-01-v4.1.json',hierarchy)\n make(P,P/'calibration-state.json','data-model-01-v4.1.json','hierarchy-model-01-v4.1.json')\n print('Part B fits complete',json.dumps({k:{p:{v:m[v] for v in ('sigma','sigma_profile_ci90','mean_by_day')} for p,m in hierarchy[k]['parameters'].items()} for k in ('primary','with_test14')},indent=2),flush=True)\nif __name__=='__main__':main()\nPY\nbash model-01-v4.1/scripts/run-command.sh python3 -m py_compile model-01-v4.1/scripts/run_part_b.py","max_output_tokens":1000}));
