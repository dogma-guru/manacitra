'rehearsal-{day}.json'),reference_fits=None,bootstrap=400,dwell_permutations=2000,seed=104196401,record_only=False,model_state=str(P/'calibration-state.json'),calibration_cache=str(P/f'rehearsal-{day}-calibration.json'),calibration_seed=seed,calibration_draws=2000,calibration_lr_trials=100,workers=4,shuffled_fits=[prefix+'-job1,'+str(fits)])\n print('Rehearsal arguments',vars(a),flush=True);r=score(a);save(a.out,{'label':'Computation rehearsal on previously opened arrays; no prospective validation. Calibration uses the v4.1 state. Prediction files are written after this rehearsal.','result':r})\n if day=='day3':\n  out=jload(a.calibration_cache);out['nominal']='D1 two 300 position monitor jobs using the day 3 design metadata as a nominal example. Any actual span count is calibrated afresh. The shuffled job is beside the monitor prediction.';save(P/'nominal-D1.json',out)\n print(day,'rehearsal complete',flush=True)\nif __name__=='__main__':main()\nPY\nbash model-01-v4.1/scripts/run-command.sh python3 -m py_compile model-01-v4.1/scripts/run_forecasts_v4_1.py","max_output_tokens":1000}));
