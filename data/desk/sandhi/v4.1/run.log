text(await tools.exec_command({cmd:"cat > model-01-v4.1/scripts/write_diff.py <<'PY'\nfrom pathlib import Path\nimport json,hashlib,difflib\nP=Path(__file__).resolve().parents[1];V=P/'input/model-01-bundle-v4.1-2026-10-19/v4-output/extracted/model-01-v4'\nchanges=json.loads((P/'scripts/scorer-changes.json').read_text())\ntext=['# Scorer changes for version 4.1','','Every source change is listed below with its correction category. Model data added for Part B are separate from these source changes. The internal review wrapper changes presentation labels only and is not part of the prospective scorer.','','C1 computes intervals, family cutoffs and count probabilities with the actual design and frozen model state. C2 uses the actual sweep times with a widened donor range and retains calibrated dimensionless comparisons outside it. C3 reads the supplied A26 span weights.','', '## Existing dependencies','','| File | Equal to v4 | SHA256 |','|---|---|---|']\naudit=[]\nfor name in ['record_io.py','hmm_model.py','hmm_core.c','hmm_core.dylib','run_boundaries.py','run_checks.py']:\n h=hashlib.sha256((P/name).read_bytes()).hexdigest();same=(P/name).read_bytes()==(V/name).read_bytes();assert same;audit.append({'file':name,'byte_equal':same,'sha256':h});text.append(f'| `{name}` | {same} | `{h}` |')\ntext+=['','## Scorer replacement blocks','','The source is renamed from `score_model_01_v4.py` to `score_model_01_v4_1.py`. The blocks below cover every changed source line. Unchanged context is supplied in the complete diff after them.']\nfor i,c in enumerate(changes):\n text+=['',f\"### Block {i+1}: {c['category']}\",'','```diff']\n text+=['-'+x for x in c['old'].splitlines()];text+=['+'+x for x in c['new'].splitlines()];text+=['```']\ntext+=['','## Complete scorer diff','','```diff']+list(difflib.unified_diff((V/'score_model_01_v4.py').read_text().splitlines(),(P/'score_model_01_v4_1.py').read_text().splitlines(),fromfile='v4/score_model_01_v4.py',tofile='v4.1/score_model_01_v4_1.py',lineterm=''))+['```']\ntext+=['','## Added calibration dependency','','Each line in `calibration_v4_1.py` is an addition. The table gives its exact line number, correction category and text. Shared imports and utilities serve C1. The support function serves C2, and the supplied weight reader serves C3.','','| Line | Correction | Source |','|---:|---|---|']\ncategory='C1';lines=(P/'calibration_v4_1.py').read_text().splitlines();mapping=[]\nfor i,line in enumerate(lines,1):\n if line.startswith('def support('):category='C2'\n elif line.startswith('_STATE='):category='C1'\n elif line.startswith('def read_a26('):category='C3'\n elif line.startswith('def apply_calibration('):category='C1'\n mapping.append({'line':i,'category':category,'text':line});escaped=line.replace('&','&amp;').replace('<','&lt;').replace('>','&gt;').replace('|','&#124;').replace('`','&#96;');text.append(f'| {i} | {category} | <code>{escaped}</code> |')\ntext+=['','The calibration state contains the empirical date means, hierarchy bootstrap samples and emission bootstrap samples required by C1. The Part A state is derived solely from hashed v4 files. The prospective state is the Part B refit. Neither source adds a middle span channel.','']\n(P/'scorer-diff-v4.1.md').write_text('\\n'.join(text));(P/'scorer-diff-audit.json').write_text(json.dumps({'unchanged_dependencies':audit,'replacement_blocks':changes,'added_dependency_lines':mapping,'source_changes_outside_C1_C2_C3':[]},indent=2));print('diff lines',len(text),'helper source lines',len(lines))\nPY\nbash model-01-v4.1/scripts/run-command.sh python3 model-01-v4.1/scripts/write_diff.py","max_output_tokens":1000}));


