text(await tools.exec_command({cmd:"bash model-01-v4.1/scripts/run-command.sh python3 - <<'PY'\nfrom pathlib import Path\nimport shutil,json\np=Path('model-01-v4.1');b=p/'input/model-01-bundle-v4.1-2026-10-19';v=b/'v4-output/extracted/model-01-v4'\nfor n in ['record_io.py','hmm_model.py','hmm_core.c','hmm_core.dylib','run_boundaries.py','run_checks.py','run_hierarchy.py']:\n shutil.copy2(v/n,p/n)\nshutil.copy2(v/'score_model_01_v4.py',p/'score_model_01_v4_1.py')\n(p/'methods-v4.1.json').write_text(json.dumps({'sequence':['check hashes','read required instructions and reports','C1 C2 C3 only','Part A using frozen v4 state','Part B add day3 then refit hierarchy','rehearse','write predictions last and seal'],'C1':'Extract only design fields from counts metadata and circuit schema. Calibrate 2000 complete days, first 1000 intervals and last 1000 joint family miss cutoffs. Preserve v4 empirical day and emission bootstrap extension. LR first 100 days with 400 null draws, same methods. Seeds fixed independently of outcomes. Unequal span counts and one job supported.','C2':{'primary':'[0.9 times minimum donor sweep time, 1.1 times maximum donor sweep time]','alternative':'Extend endpoints by 0.1 times donor range width, recorded beside; not selected by outcome.','outside':'Seconds remain uncalibrated. Correlation family uses a separately simulated dimensionless subfamily; all seconds outcomes remain displayed.'},'C3':'Read published per span A26 weighted_mean from explicitly supplied run fits. No A26 reconstruction. Shuffled sd definition has no unique observed population length scalar; retain unavailable with alternatives, do not silently choose.','unchanged':'All exact likelihood, record quantities, bootstrap, boundary and dwell algorithms remain byte identical to v4. Old qubit job fits and bootstrap draws are retained since the likelihood factorizes by job; new jobs use the identical method.','numerics':'float64; NumPy PCG64; Python 3.14.8 NumPy 2.5.3 SciPy 1.18.1','seeds':{'calibration':41119001,'PartB_fits_base':41119100,'PartB_hierarchy_primary':41119200,'PartB_hierarchy_with14':41119210,'D1_nominal':41119301,'D2_nominal':41119302},'scope':'Bundle only; no external scientific records; prior memory used only for workflow orientation before source reading.'},indent=2))\nPY","max_output_tokens":1000}));


