text(await tools.exec_command({cmd:"cat > model-01-v4.1/scripts/patch_scorer.py <<'PY'\nfrom pathlib import Path\nimport difflib,json,hashlib\nP=Path(__file__).resolve().parents[1];V=P/'input/model-01-bundle-v4.1-2026-10-19/v4-output/extracted/model-01-v4'\ns=(V/'score_model_01_v4.py').read_text();changes=[]\ndef replace(old,new,category):\n global s\n assert s.count(old)==1,(old[:80],s.count(old));s=s.replace(old,new);changes.append({'category':category,'old':old,'new':new})\nreplace(\"            family=entry.get('family',quantity)\",\"            # C2 seconds outside support remain beside; calibrate the dimensionless subfamily.\\n            if quantity in ('t15_tau_seconds','model_ell_seconds') and not scenario.get('_applicability',{}).get('seconds_applicable',True):\\n                continue\\n            family=entry.get('family',quantity)\",'C2')\nreplace(\"'missing_A26':'No implementation or complete definition of A26 is included; no new shuffled weight is calculated'\",\"'missing_A26':'C3 reads supplied per span A26 weights; no estimator is recomputed'\",'C3')\nreplace(\"            rows.append({'span':s['span'],'quadratures':quadratures,'A26':{'status':'unavailable','reason':result['definitions']['missing_A26']}})\\n            add_observation(observations,'shuffled_weight_A26',f'{key} span {s[\\\"span\\\"]}',None,reason=result['definitions']['missing_A26'])\\n            add_observation(observations,'shuffled_sd',f'{key} span {s[\\\"span\\\"]}',None,reason='A26 weight and its population length inputs are needed')\",\n\"            from calibration_v4_1 import read_a26\\n            a26=read_a26(args.shuffled_fits,key,s['span'])\\n            rows.append({'span':s['span'],'duration_s':s['duration_s'],'sweep_s':s['duration_s']/len(next(iter(arr.values()))),'quadratures':quadratures,'A26':a26})\\n            add_observation(observations,'shuffled_weight_A26',f'{key} span {s[\\\"span\\\"]}',a26.get('value'),reason=a26.get('reason'),source=a26)\\n            add_observation(observations,'shuffled_sd',f'{key} span {s[\\\"span\\\"]}',None,reason='C3 supplies A26 weight but the v4 definition gives a distribution of population lengths, not one observed scalar; no unique observed sd is defined')\",'C3')\nstart=\"    scenario_key=str(span_counts[0]) if span_counts and len(set(span_counts))==1 else None\"\nend=\"    scenario={**scenario,'_applicability':result['scenario_applicability']}\"\nold=s[s.index(start):s.index(end)+len(end)]\nreplace(old,\"    # C1 actual design calibration uses frozen model state and no observed quantities.\\n    from calibration_v4_1 import apply_calibration\\n    predictions,scenario,calibration=apply_calibration(predictions,result['jobs'],result['shuffled'],args)\\n    scenario_key='actual';scenarios=predictions['scenarios']\\n    result['calibration']=calibration\\n    result['scenario_applicability']=scenario['_applicability']\",'C1')\nreplace(\"    args=p.parse_args()\",\"    # C1 calibration controls and frozen state; C3 explicitly supplied run fits.\\n    p.add_argument('--model-state')\\n    p.add_argument('--calibration-cache')\\n    p.add_argument('--calibration-seed',type=int,default=41119001)\\n    p.add_argument('--calibration-draws',type=int,default=2000)\\n    p.add_argument('--calibration-lr-trials',type=int,default=100)\\n    p.add_argument('--workers',type=int,default=4)\\n    p.add_argument('--shuffled-fits',action='append',default=[],help='C3 key,path to the run fits file')\\n    args=p.parse_args()\",'C1,C3')\n(P/'score_model_01_v4_1.py').write_text(s)\n(P/'scripts/scorer-changes.json').write_text(json.dumps(changes,indent=2))\nPY\nbash model-01-v4.1/scripts/run-command.sh python3 model-01-v4.1/scripts/patch_scorer.py\ncat > model-01-v4.1/scripts/make_state.py <<'PY'\nfrom pathlib import Path\nimport json,hashlib,sys\nP=Path(__file__).resolve().parents[1]\ndef make(source,dest,data_name,hier_name):\n data=json.loads((source/data_name).read_text())['spans'];ss=[s for s in data if s['processor']=='ibm_fez' and s['test']!='t14'];dates=sorted(set(s['date'] for s in ss));jobs={d:sorted(set(s['fit_group'] for s in ss if s['date']==d)) for d in dates}\n state={'hierarchy':json.loads((source/hier_name).read_text())['primary'],'dates':dates,'jobs_by_date':jobs,\n 'emission_bootstrap':{j:[{k:b[k] for k in ('q_H','q_L')} for b in json.loads((source/('bootstrap-'+j+'.json')).read_text())['samples']] for j in set(s['fit_group'] for s in ss)},\n 'sweep_seconds_donor_support':sorted(set(s['sweep_s'] for s in ss)),\n 'basis':{'spans':len(ss),'jobs':len(set(s['fit_group'] for s in ss)),'dates':len(dates)},\n 'source_hashes':{n:hashlib.sha256((source/n).read_bytes()).hexdigest() for n in [data_name,hier_name]+['bootstrap-'+j+'.json' for j in sorted(set(s['fit_group'] for s in ss))]}}\n dest.write_text(json.dumps(state,indent=2));print(dest,state['basis'])\nif __name__=='__main__':\n if sys.argv[1]=='v4':make(P/'input/model-01-bundle-v4.1-2026-10-19/v4-output/extracted/model-01-v4',P/'frozen-v4-calibration-state.json','data-model-01-v4.json','hierarchy-model-01-v4.json')\n else:make(P,P/'calibration-state.json','data-model-01-v4.1.json','hierarchy-model-01-v4.1.json')\nPY\nbash model-01-v4.1/scripts/run-command.sh python3 model-01-v4.1/scripts/make_state.py v4","max_output_tokens":1000}));


