text(await tools.exec_command({cmd:"cat > model-01-v4.1/scripts/audit_calibration.py <<'PY'\nfrom pathlib import Path\nimport json,sys\nimport numpy as np\nfrom scipy.stats import beta\nP=Path(__file__).resolve().parents[1];rows=[]\nfor name in ('part-a-calibration.json','rehearsal-day2-calibration.json','rehearsal-day3-calibration.json','nominal-D2.json'):\n obj=json.loads((P/name).read_text());s=obj['scenario'];tr=obj['trials'];n=len(tr);half=n//2;checks=[]\n for q,interval in s['intervals'].items():\n  if interval is None:continue\n  vals=np.array([v for t in tr[:half] for v in t['values'][q]],dtype=np.float64);calc=np.quantile(vals[np.isfinite(vals)],[.05,.95]).tolist()\n  if q=='shuffled_weight_A26':calc=[max(0,calc[0]-.011),min(1,calc[1]+.011)]\n  checks.append({'field':'interval.'+q,'equal':calc==interval,'recomputed':calc})\n for fam,v in s['family_miss_thresholds'].items():\n  misses=[]\n  for t in tr[half:]:misses.append(sum(x is None or x<s['intervals'][q][0] or x>s['intervals'][q][1] for q in v['quantities'] for x in t['values'][q]))\n  cutoff=None\n  for k in range(1,v['k']+1):\n   count=sum(x>=k for x in misses);upper=float(beta.ppf(.95,count+1,half-count)) if count<half else 1.\n   if upper<.05:cutoff=k;break\n  checks.append({'field':'cutoff.'+fam,'equal':cutoff==v['cutoff'],'recomputed':cutoff})\n for w,r in s['boundary_counts'].items():\n  counts=[t['boundary_words'].count(w) for t in tr];checks.append({'field':'boundary.'+w,'equal':float(np.mean(counts))==r['expected_count'] and np.quantile(counts,[.05,.95]).tolist()==r['interval_90']})\n checks.append({'field':'sharing_probability','equal':sum(t['all_shared'] for t in tr)/n==s['sharing_all_probability']['probability']})\n lrs=[t for t in tr if t['lr']];complete=[t for t in lrs if all(x['p'] is not None and not x['failures'] for x in t['lr'])];lp=s['any_LR_reject_probability']\n checks.append({'field':'LR_probability','equal':len(complete)==100 and lp['probability']==sum(any(x['p']<.01 for x in t['lr']) for t in complete)/len(complete)})\n failures=[x for t in tr for x in t['failures']]\n rows.append({'file':name,'draws':n,'interval_draws':half,'family_draws':n-half,'LR_trials':len(complete),'null_draws_per_LR':lp['null_draws_per_comparison'],'seed':s['seed'],'checks':checks,'all_equal':all(c['equal'] for c in checks),'optimizer_failures':len(failures),'finite_values':all(x is not None and np.isfinite(x) for t in tr for a in t['values'].values() for x in a)})\n assert rows[-1]['all_equal'] and not failures and rows[-1]['finite_values']\n(P/'calibration-audit.json').write_text(json.dumps({'independent_recount':rows,'method':'Standalone recount of intervals, family cutoffs and boundary counts using saved trials; no import of the calibration implementation.'},indent=2));print(json.dumps([{k:v for k,v in x.items() if k!='checks'} for x in rows],indent=2))\nPY\nbash model-01-v4.1/scripts/run-command.sh python3 -m py_compile model-01-v4.1/scripts/audit_calibration.py","max_output_tokens":1000}));
