text(await tools.exec_command({cmd:"bash model-01-v4.1/scripts/run-command.sh python3 - <<'PY'\nfrom pathlib import Path\nimport re,json,hashlib\nP=Path('model-01-v4.1');names=['report-model-01-v4.1.md','internal-review-day3.md','predictions-model-01-v4.1.md','README.md']\nfor n in names:\n s=(P/n).read_text();s=re.sub(r'```.*?```','',s,flags=re.S);s=re.sub(r'`[^`]*`','',s)\n findings=[]\n for i,line in enumerate(s.splitlines(),1):\n  if re.match(r'^\\|[-|: ]+\\|$',line):continue\n  if re.search(r'\\b(proves|reveals|kill|verified|benchmark|parity|defect)\\b|pre-registered|[—–]',line,re.I):findings.append((i,line))\n  if '-' in line:findings.append((i,'dash: '+line))\n print(n,'wording findings',findings)\n# Confirm every original frozen v4 manifest entry remains intact.\nV=P/'input/model-01-bundle-v4.1-2026-10-19/v4-output/extracted/model-01-v4'\nfor line in (V/'SHA256SUMS').read_text().splitlines():\n h,n=line.split(maxsplit=1);assert hashlib.sha256((V/n).read_bytes()).hexdigest()==h,n\nprint('Frozen v4 manifest remains intact')\np=json.loads((P/'predictions-model-01-v4.1.json').read_text());assert p['calibration_state_sha256']==hashlib.sha256((P/'calibration-state.json').read_bytes()).hexdigest();print('Prospective state digest agrees')\nPY","max_output_tokens":2000}));


