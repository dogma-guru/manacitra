field':'between_jobs','computed':{'ratio':a['ratio'],'word':a['word']},'published':{'ratio':x['this_read_ratio'],'word':x['this_read_word']},'exact_equal':a['ratio']==x['this_read_ratio'] and a['word']==x['this_read_word'],'absolute_difference':abs(a['ratio']-x['this_read_ratio']),'equal_at_1e12':abs(a['ratio']-x['this_read_ratio'])<=1e-12 and a['word']==x['this_read_word']})\nfor x in REF['shuffled_job1']:\n s=next(s for s in NEW['shuffled'][0]['spans'] if s['span']==x['span']);add('shuffled.'+str(x['span'])+'.'+x['quadrature']+'.'+x['field'],s['quadratures'][x['quadrature']]['reading'][x['field']],x['this_read'])\nassert len(checks)==125\n# Compare every unchanged leaf, allowing only source path relocation and wall clock timing.\ndiffs=[];exact=0;close=0;maxdiff=0.;compared=0\nskip={'computed_utc','prediction_file','prediction_sha256','versions','prediction_scores','prediction_comparisons','scenario_scores','scenario_comparisons','scenario_applicability','families','unavailable_outcomes','matching_scenario','definitions'}\ndef compare(a,b,path):\n global exact,close,maxdiff,compared\n if isinstance(a,dict) and isinstance(b,dict):\n  for k in b:\n   if k in ('array','meta','counts','source') and ('source' in path or k=='source'):continue\n   if k=='A26' or k in ('shuffled_weight_A26','shuffled_sd'):continue\n   if k not in a:diffs.append({'path':path+'.'+k,'reason':'missing'});continue\n   compare(a[k],b[k],path+'.'+k)\n elif isinstance(a,list) and isinstance(b,list):\n  if len(a)!=len(b):diffs.append({'path':path,'lengths':[len(a),len(b)]});return\n  for i,(x,y) in enumerate(zip(a,b)):compare(x,y,path+f'[{i}]')\n else:\n  compared+=1\n  if a==b:exact+=1;close+=1;return\n  if isinstance(a,(int,float)) and isinstance(b,(int,float)):\n   delta=abs(a-b);maxdiff=max(maxdiff,delta)\n   if delta<=1e-12:close+=1;return\n  diffs.append({'path':path,'new':a,'old':b})\nfor k,v in OLD.items():\n if k not in skip:compare(NEW[k],v,k)\n# C1 no observed values survive the design allowlist.\nfrom calibration_v4_1 import design_only\nimport copy\nj=copy.deepcopy(NEW['jobs']);sh=copy.deepcopy(NEW['shuffled']);design=design_only(j,sh)\nfor g in j:\n for s in g['series']:\n  s['n']=[[0]*len(row) for row in s['n']];s['t15']={};s['fit']={};s['record_c']=0\n g['fit']={}\nfor g in sh:\n for s in g['spans']:s['A26']={'value':0};s['quadratures']={}\nblind=design_only(j,sh)==design\nout={'comparison_125':{'count':len(checks),'exact_equal_count':sum(c['exact_equal'] for c in checks),'within_1e12_count':sum(c['equal_at_1e12'] for c in checks),'max_absolute_difference':max(c['absolute_difference'] or 0 for c in checks),'rows':checks},'unaffected_v4_scorecard':{'compared_leaves':compared,'exact_equal':exact,'within_1e12':close,'max_absolute_difference':maxdiff,'differences':diffs,'excluded_fields':sorted(skip),'note':'Only C1 C2 C3 products, execution provenance, and relocated source paths excluded. Original fit, path, record, dwell and boundary outputs compared.'},'C1_design_invariant_to_observed_values':blind}\n(P/'audit-part-a.json').write_text(json.dumps(native(out),indent=2));print(json.dumps({k:{a:b for a,b in v.items() if a!='rows'} if isinstance(v,dict) else v for k,v in out.items()},indent=2))\nassert all(c['equal_at_1e12'] for c in checks) and not diffs and blind\nPY\nbash model-01-v4.1/scripts/run-command.sh python3 -m py_compile model-01-v4.1/scripts/audit_part_a.py","max_output_tokens":1000}));
